# ── Operator data — never commit ──────────────────────────────────────────

# SSH target config (contains host/user/port — no credentials, but host-specific)
config/target.json

# Reportes: escaneos, evidencia y reportes generados
reportes/

# Current run id marker (temporary state)
.run_id

# ── Python artifacts ──────────────────────────────────────────────────────

__pycache__/
*.pyc
*.pyo

# ── OS / editor / temp ────────────────────────────────────────────────────

.DS_Store
.vscode/
.idea/
*.swp
*.log
*.tmp
*.bak

# ── Secrets / credentials (defensivo) ─────────────────────────────────────

*.key
*.pem
*.p12
*.pfx
.env
.env.*
!.env.example

# ── SSH keys ──────────────────────────────────────────────────────────────

id_rsa
id_ed25519
id_ecdsa
*.pub

# ── Runtime ───────────────────────────────────────────────────────────────

*.pid

# ── Tracked files (everything else is the reusable framework) ─────────────
# skills/**/*.md   — reusable skill instruction sets
# scripts/*.{sh,py} — core tools
# workflows/*.md    — entry points
# templates/*.md    — report templates
# lib/*             — severity matrix, compat tables
# config/target.example.json — template for new targets
# AGENTS.md README.md *.md  — documentation
# .gitignore        — this file
